# my-zeroshot target image: the zeroshot target with the pi harness, a checkpoint-safe
# restic, and this operator's pi extensions baked in.
#
# Differences from the upstream docker/zeroshot-target/Dockerfile:
#   * pi is the only harness (no codex, claude or copilot),
#   * restic is wrapped so workspaces do not snapshot Rust build output,
#   * pi 1.4.0 (not 1.0.3) so the extensions below run on the API they were tested against,
#   * a launcher loads those extensions through explicit --extension arguments.
#
# Build it with ./build.sh, which stages the zeroshot source as the build context.
# syntax=docker/dockerfile:1

FROM node:24-trixie-slim AS ui-builder

WORKDIR /src
COPY ui/package.json ui/package-lock.json ./ui/
RUN npm --prefix ui ci --ignore-scripts
COPY ui ./ui
RUN npm --prefix ui run build

FROM rust:1.97.0-trixie AS rust-toolchain
# llvm-tools-preview provides llvm-cov/llvm-profdata; cargo-llvm-cov drives them.
# Without both, a coverage job dies with "error: no such command: llvm-cov".
ARG CARGO_LLVM_COV_VERSION=0.6.21
RUN rustup component add rustfmt clippy llvm-tools-preview \
    && cargo install --locked --version "${CARGO_LLVM_COV_VERSION}" cargo-llvm-cov \
    && mkdir -p /opt/rustup \
    && cp -a /usr/local/rustup/. /opt/rustup/ \
    && cp -a /usr/local/cargo/bin /opt/rustup/bin \
    && chmod -R go-w /opt/rustup

FROM golang:1.27.1-trixie AS restic-builder
ARG TARGETARCH
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-p=4
COPY scripts/distribution/build-restic.sh /usr/local/bin/build-restic
RUN case "$TARGETARCH" in \
      amd64) target=x86_64-unknown-linux-musl ;; \
      arm64) target=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported Restic architecture: $TARGETARCH" >&2; exit 2 ;; \
    esac \
    && build-restic /out "$target" \
    && cp "/out/$target/restic" /out/restic \
    && /out/restic version

FROM rust-toolchain AS builder

WORKDIR /src

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY zeroshot ./zeroshot
COPY --from=ui-builder /src/ui/dist ./ui/dist

RUN cargo build --locked --release --package zeroshot --bin zeroshot --features ui

FROM python:3.12.14-slim-trixie@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS python-runtime

# A Go toolchain, so a Go repository (barse) can be built and tested on a target. The image
# already carries Rust; Go is the other toolchain the operator's repositories need.
FROM golang:1.26.1-trixie AS go-toolchain
RUN mkdir -p /opt/go \
    && cp -a /usr/local/go/. /opt/go/ \
    && chmod -R go-w /opt/go

FROM node:24-trixie-slim AS tooling

ARG PI_VERSION=1.4.0
ARG BILLION_CONTEXT_VERSION=0.1.207
ARG PI_WEB_ACCESS_VERSION=0.44.0
ARG PI_BACKGROUND_TERMINAL_VERSION=0.12.0
ARG TARGETARCH
ARG GH_VERSION=2.101.0
ARG NPM_VERSION=11.19.1
ARG TEMPL_VERSION=0.3.1020
ARG SQLC_VERSION=1.31.1
ARG STATICCHECK_VERSION=2026.2.1
ARG TAILWINDCSS_VERSION=4.1.3
ARG ZEROSHOT_VERSION=development
ARG VCS_REF=unknown

LABEL org.opencontainers.image.source="https://github.com/naqerl/my-zeroshot" \
      org.opencontainers.image.title="my-zeroshot target" \
      org.opencontainers.image.version="${ZEROSHOT_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}"

# Verify the upstream package independently of Debian's GitHub CLI version.
ADD --checksum=sha256:f8bbc37fc5568a6a162d1a67b1e9c1afa9139f7b5a46dcde4a57bdaa0db33b60 \
    https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_checksums.txt /tmp/github-cli/checksums.txt
ADD https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${TARGETARCH}.deb /tmp/github-cli/

RUN cd /tmp/github-cli \
    && sha256sum --check --ignore-missing checksums.txt \
    && apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        chromium \
        curl \
        docker-cli \
        docker-buildx \
        docker-compose \
        /tmp/github-cli/gh_${GH_VERSION}_linux_${TARGETARCH}.deb \
        git \
        fonts-liberation \
        openssh-client \
        libbz2-1.0 \
        libffi-dev \
        libgdbm6t64 \
        liblzma5 \
        libncursesw6 \
        libnss-wrapper \
        libreadline8t64 \
        libsqlite3-0 \
        libssl-dev \
        libuuid1 \
        pkgconf \
        procps \
        ripgrep \
    && install -d /usr/local/lib/zeroshot \
    && ln -s "/usr/lib/$(dpkg-architecture -qDEB_HOST_MULTIARCH)/libnss_wrapper.so" \
        /usr/local/lib/zeroshot/libnss_wrapper.so \
    && test -r /usr/local/lib/zeroshot/libnss_wrapper.so \
    && git_version="$(git --version)" \
    && dpkg --compare-versions "${git_version#git version }" ge 2.47 \
    && chromium --version \
    && rm -rf /var/lib/apt/lists/* /tmp/github-cli

COPY --from=python-runtime /usr/local /usr/local
COPY --from=rust-toolchain /opt/rustup /opt/rustup

# The Go toolchain and the generator binaries a Go/templ repository builds with. Every one is
# pinned by the same ARG the repository's Makefile pins, so `make templ` / `make sqlc` work
# without network access and without `make install-deps`.
COPY --from=go-toolchain /opt/go /opt/go
ENV GOROOT=/opt/go \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright \
    CHROME_BIN=/usr/bin/chromium
RUN ln -sf /opt/go/bin/go /usr/local/bin/go \
    && ln -sf /opt/go/bin/gofmt /usr/local/bin/gofmt \
    && install -d /opt/gotools/bin \
    && curl -sSfL -o /tmp/templ.tar.gz "https://github.com/a-h/templ/releases/download/v${TEMPL_VERSION}/templ_Linux_x86_64.tar.gz" \
    && tar -xzf /tmp/templ.tar.gz -C /opt/gotools/bin templ \
    && curl -sSfL -o /tmp/sqlc.tar.gz "https://github.com/sqlc-dev/sqlc/releases/download/v${SQLC_VERSION}/sqlc_${SQLC_VERSION}_linux_amd64.tar.gz" \
    && tar -xzf /tmp/sqlc.tar.gz -C /opt/gotools/bin sqlc \
    && curl -sSfL -o /tmp/staticcheck.tar.gz "https://github.com/dominikh/go-tools/releases/download/${STATICCHECK_VERSION}/staticcheck_linux_amd64.tar.gz" \
    && tar -xzf /tmp/staticcheck.tar.gz -C /tmp staticcheck/staticcheck \
    && mv /tmp/staticcheck/staticcheck /opt/gotools/bin/staticcheck \
    && curl -sSfL -o /opt/gotools/bin/tailwindcss "https://github.com/tailwindlabs/tailwindcss/releases/download/v${TAILWINDCSS_VERSION}/tailwindcss-linux-x64" \
    && chmod 0755 /opt/gotools/bin/* \
    && for tool in templ sqlc staticcheck tailwindcss; do ln -sf "/opt/gotools/bin/$tool" "/usr/local/bin/$tool"; done \
    && rm -rf /tmp/templ.tar.gz /tmp/sqlc.tar.gz /tmp/staticcheck.tar.gz /tmp/staticcheck \
    && go version \
    && templ --help >/dev/null 2>&1 \
    && sqlc version \
    && tailwindcss --help >/dev/null 2>&1

# Browsers for the Go e2e suite. Built once, not downloaded per run: a target run has no root,
# so `playwright install --with-deps` cannot work there. A failure here must not fail the image —
# an image without browsers still builds and tests Go code, and the run says so in its report.
RUN cd /tmp \
    && mkdir -p pw \
    && cd pw \
    && go mod init pw >/dev/null 2>&1 \
    && go get github.com/mxschmitt/playwright-go@latest >/dev/null 2>&1 \
    && go run github.com/mxschmitt/playwright-go/cmd/playwright install chromium \
    || echo "warning: playwright browsers were not installed"

COPY --chmod=0755 docker/zeroshot-target/rust-tool.sh /usr/local/libexec/zeroshot-rust-tool
RUN for tool in cargo cargo-clippy cargo-fmt cargo-llvm-cov clippy-driver rustc rustdoc rustfmt rustup; do \
        ln -s /usr/local/libexec/zeroshot-rust-tool "/usr/local/bin/$tool"; \
    done \
    && ldconfig

COPY --chmod=0755 docker/zeroshot-target/harness.sh /usr/local/libexec/zeroshot-harness

# pi and this operator's extensions. npm needs to see every dependency install script it will
# run: esbuild downloads/link its platform binary, @google/genai and protobufjs declare
# install scripts that must be allowed explicitly.
RUN install -d /opt/zeroshot/bin /opt/zeroshot/harness/lib/node_modules /opt/zeroshot/pi-extensions/lib/node_modules \
    && cp /usr/local/bin/node /opt/zeroshot/bin/node \
    && npm install --global --no-audit --no-fund "npm@${NPM_VERSION}" \
    && npm install --global --prefix /opt/zeroshot/harness --no-audit --no-fund \
        --strict-allow-scripts \
        --allow-scripts=esbuild,@google/genai,protobufjs \
        "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && npm install --global --prefix /opt/zeroshot/pi-extensions --no-audit --no-fund \
        --strict-allow-scripts \
        --allow-scripts=esbuild,@google/genai,protobufjs \
        "billion-context@${BILLION_CONTEXT_VERSION}" \
        "pi-web-access@${PI_WEB_ACCESS_VERSION}" \
        "@bytetrue/pi-background-terminal@${PI_BACKGROUND_TERMINAL_VERSION}" \
    && npm cache clean --force

# Resolve each package's declared pi extension entry point into a list the launcher reads,
# then install the launcher over the harness symlink. `--global --prefix` puts the packages in
# DIR/lib/node_modules; npm rejects `--allow-scripts` on project-scoped installs.
COPY docker/pi/resolve-extensions.sh /usr/local/libexec/zeroshot-pi-extensions
COPY docker/pi/pi-launcher.sh /usr/local/bin/pi
RUN chmod 0755 /usr/local/libexec/zeroshot-pi-extensions /usr/local/bin/pi \
    && /usr/local/libexec/zeroshot-pi-extensions \
        /opt/zeroshot/pi-extensions/lib/node_modules \
        /opt/zeroshot/pi-extensions/list \
        billion-context pi-web-access @bytetrue/pi-background-terminal \
    && test -s /opt/zeroshot/pi-extensions/list

FROM tooling AS runtime

COPY --from=builder /src/target/release/zeroshot /usr/local/bin/zeroshot
COPY --from=restic-builder /out/restic /usr/local/bin/restic.real
COPY docker/zeroshot-target/entrypoint.sh /usr/local/bin/zeroshot-target-entrypoint

# Workspace checkpoints must not snapshot Rust build output, or a 15 GB workspace/target
# exhausts the checkpoint budget and the run dies with
# "workspace checkpoint is unavailable: restic operation failed".
COPY docker/zeroshot-target/restic-shim.sh /usr/local/bin/restic
# A verifier captures UI evidence with the chromium baked into this image;
# nothing is downloaded and no npx runs during a review.
COPY --chmod=0755 docker/zeroshot-target/chromium-shot /usr/local/bin/chromium-shot
RUN chmod 0755 /usr/local/bin/restic \
    && /usr/local/bin/restic version \
    && command -v chromium-shot

# The native runtime deliberately retains root so it can isolate node processes.
# Root owns target state; execute-only access lets isolated run UIDs reach their own workspaces.
RUN install -d -m 0711 /var/lib/zeroshot/native-v2 \
    && chmod 0755 /usr/local/bin/zeroshot-target-entrypoint

VOLUME ["/var/lib/zeroshot"]
EXPOSE 8080

ENTRYPOINT ["zeroshot-target-entrypoint"]
CMD ["target", "serve", "--listen", "0.0.0.0:8080", "--public-origin", "http://127.0.0.1:8080", "--storage", "/var/lib/zeroshot/native-v2"]
